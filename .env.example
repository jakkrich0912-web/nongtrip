# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# ตัวช่วยตอบในหน้าแชต: mock = โหมดสำรองแบบกฎ ไม่ต้องใช้คีย์ / anthropic / openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# ข้อมูลสถานที่และที่พักจาก OpenStreetMap (Nominatim/Overpass) 0 = ปิด ใช้ได้แค่ข้อมูลที่ตรวจที่มาแล้ว
OSM_LIVE=1

# ล็อกอิน: ข้อความลับสำหรับเซ็นเซสชัน ใส่ข้อความสุ่มยาวๆ ของตัวเอง
SESSION_SECRET=
