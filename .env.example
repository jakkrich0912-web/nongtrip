# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# ตัวช่วยตอบในหน้าแชต: mock = โหมดกฎ ไม่ต้องใช้คีย์ / anthropic / openai / gemini / xai (Grok)
# ถ้าเลือกเจ้าไหน ต้องใส่คีย์ของเจ้านั้นและ LLM_MODEL ด้วย ไม่ครบ = ถอยเป็นโหมดกฎ
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
LLM_MODEL=

# ตัวสำรอง (ไม่บังคับ): ตัวหลักล่ม คีย์ผิด หรือเครดิตหมด ลองตัวถัดไปตามลำดับ เช่น LLM_FALLBACK=gemini,xai
# ตัวสำรองแต่ละตัวต้องมีคีย์ข้างบนและรุ่นของตัวเองข้างล่าง ตั้งไม่ครบถูกข้าม เว้นว่าง = ไม่มีตัวสำรอง (เหมือนเดิม)
LLM_FALLBACK=
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
XAI_MODEL=

# ข้อมูลสถานที่และที่พักจาก OpenStreetMap (Nominatim/Overpass) 0 = ปิด ใช้ได้แค่ข้อมูลที่ตรวจที่มาแล้ว
OSM_LIVE=1
PLACES_CACHE_DIR=data/cache
# โฟลเดอร์สแนปช็อต OSM ที่ดึงไว้ล่วงหน้า (ไม่ตั้ง = services/places/data/osm_snapshot)
# OSM_SNAPSHOT_DIR=

# ล็อกอิน: ข้อความลับสำหรับเซ็นเซสชัน ใส่ข้อความสุ่มยาวๆ ของตัวเอง
SESSION_SECRET=
# 0 = ไม่ใส่ Secure ในคุกกี้เซสชัน (ใช้ตอนพัฒนาบน http เท่านั้น ตอนใช้จริงต้องเป็น 1)
SESSION_SECURE=1
# ล็อกอินด้วย Google: Client ID จาก Google Cloud Console (OAuth client แบบ Web) ไม่ตั้ง = ปิดปุ่ม Google (API ตอบ 501)
# ไม่ใช่ความลับ docker compose ส่งค่าเดียวกันให้หน้าเว็บตอน build เอง แก้แล้วต้อง build ใหม่ทั้ง api และ web
# และต้องใส่ที่มาของเว็บ (เช่น http://localhost:8081) ใน Authorized JavaScript origins
GOOGLE_CLIENT_ID=

# อีเมลของผู้ดูแลระบบ คั่นด้วยจุลภาค เข้าหน้า /admin (แดชบอร์ดยอดรวมของระบบ) ได้ ไม่ตั้ง = ไม่มีใครเป็นผู้ดูแล
ADMIN_EMAILS=
# จำนวนข้อความแชตต่อ IP ต่อนาที (เกินแล้วตอบ 429)
CHAT_RATE_PER_MIN=20
# ไฟล์ฐานข้อมูลผู้ใช้/ประวัติ (SQLite) ค่าเริ่มต้น data/nongtrip.db
# DB_PATH=

# รันด้วย Docker (make up): พอร์ตที่เปิดหน้าเว็บบนเครื่อง ค่าเริ่มต้น 8080
# WEB_PORT=8080
